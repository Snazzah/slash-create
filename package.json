{
  "name": "slash-create",
  "version": "7.1.0",
  "description": "Create and sync Discord slash commands!",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./web": {
      "types": "./lib/web/index.d.ts",
      "default": "./lib/web/index.js"
    },
    "./lib/*.js": "./lib/*.js",
    "./package.json": "./package.json"
  },
  "author": {
    "name": "Snazzah",
    "email": "me@snazzah.com",
    "url": "https://snazzah.com/"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Snazzah/slash-create.git"
  },
  "bugs": {
    "url": "https://github.com/Snazzah/slash-create/issues"
  },
  "homepage": "https://slash-create.js.org/",
  "keywords": [
    "api",
    "discord",
    "discordapp",
    "slash-command",
    "slash-commands",
    "discord-interactions",
    "wrapper"
  ],
  "scripts": {
    "build": "rimraf lib && tsc && tsx scripts/postbuild",
    "build:prepare": "shx test -d ./lib || npm run build",
    "changelog": "tsx scripts/changelog",
    "docs": "typedoc src --entryPointStrategy expand --json .tmp/typedoc-out.json --excludeExternals && tsx scripts/docs && tsx scripts/validate-docs",
    "lint": "oxlint src",
    "lint:sarif": "oxlint src --quiet -f sarif > oxlint-results.sarif",
    "lint:fix": "oxlint src --fix",
    "test": "mocha -r tsx --extension ts --forbid-pending \"test/**/*.ts\"",
    "gpr": "tsx scripts/gpr",
    "prepare": "npm run build:prepare",
    "prepublishOnly": "(shx test -d ./lib || (echo \"lib folder does not exist\" && exit 1)) && npm run lint:fix && npm run format",
    "format": "oxfmt src test",
    "format:check": "oxfmt src test --check"
  },
  "funding": {
    "url": "https://github.com/sponsors/Snazzah"
  },
  "packageManager": "pnpm@10.34.5",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "ts-docgen@https://codeload.github.com/dbots-pkg/ts-docgen/tar.gz/110ac18d2ee56b0f946cac069a6e51d35a099f78"
    ]
  },
  "engines": {
    "node": ">=18.17"
  },
  "dependencies": {
    "dequal": "^2.0.3",
    "eventemitter3": "^5.0.1",
    "tweetnacl": "^1.0.3",
    "undici": "^6.28.0"
  },
  "devDependencies": {
    "@sinonjs/fake-timers": "15.4.0",
    "@types/aws-lambda": "^8.10.162",
    "@types/chai": "^5.2.3",
    "@types/chai-as-promised": "^8.0.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.1.2",
    "@types/sinonjs__fake-timers": "15.0.1",
    "chai": "^6.2.2",
    "chai-as-promised": "^8.0.2",
    "fastify": "^5.10.0",
    "mocha": "^11.7.6",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "rimraf": "^6.1.3",
    "shx": "^0.4.0",
    "ts-docgen": "github:dbots-pkg/ts-docgen#main",
    "tsx": "^4.23.1",
    "typedoc": "0.28.20",
    "typescript": "6.0.3"
  },
  "peerDependencies": {
    "express": "^4 || ^5",
    "fastify": "^3 || ^4 || ^5"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    },
    "fastify": {
      "optional": true
    }
  }
}
